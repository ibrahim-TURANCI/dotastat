# DotaStat ortam degiskenleri
#
# Yerel gelistirme: bu dosyayi `.env` olarak kopyala.
# Netlify: Site settings -> Environment variables altina ayni anahtarlari gir.

# --- Zorunlu (production) ---------------------------------------------------

# Steam oturum cerezini imzalar. Rastgele uzun bir dize uret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Masaustu uygulamasinin canli mac verisini gonderebilmesi icin paylasilan sir.
# Ayni degeri Electron uygulamasinin ayarlarina da girmen gerekir.
LIVE_INGEST_TOKEN=

# --- Opsiyonel --------------------------------------------------------------

# OpenDota API anahtari. Olmadan da calisir, sadece limit daha dusuktur.
# https://www.opendota.com/api-keys
OPENDOTA_API_KEY=

# Stratz API anahtari (ucretsiz). OpenDota gunluk limitine takildiginda veri
# buradan cekilir. Bos birakilirsa yedek kaynak devre disi kalir; OpenDota
# limitte oldugunda ekran onbellekteki son veriyi gosterir.
# https://stratz.com/api
# NOT: Buraya gercek anahtar YAZMA — bu dosya repoya girer. Anahtari `.env`
# dosyasina koy (o .gitignore'da) ya da Netlify ortam degiskenlerine gir.
STRATZ_API_KEY=

# "Masaustu surumunu indir" butonunun bakacagi repo: kullanici/repo
GITHUB_REPO=

# Ozel repo veya GitHub API limiti icin (genel repoda gerekmez).
GITHUB_TOKEN=

# --- Masaustu uygulamasi (packages/desktop) ---------------------------------

# Canli mac verisinin gonderilecegi adres. Bos birakilirsa yayin yapilmaz.
DOTASTAT_CLOUD_URL=
DOTASTAT_INGEST_TOKEN=

# Yerel sunucu portu (Dota GSI yapilandirmasi da bu portu kullanir).
PORT=3044
